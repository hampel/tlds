{
    "name": "hampel/tlds",
    "description": "Fetches the latest list of Top Level Domains from IANA, plus Laravel classes for validating TLDs",
	"homepage" : "https://github.com/hampel/tlds",
	"authors": [{
		"name": "Simon Hampel",
		"email": "simon@hampelgroup.com"
	}],
	"support": {
		"issues": "https://github.com/hampel/tlds/issues",
		"source": "https://github.com/hampel/tlds"
	},
	"keywords": [
		"tld",
		"domain",
		"iana",
		"domain name",
		"laravel",
        "top-level-domains",
        "domain-names"
	],
	"license" : "MIT",
    "require": {
        "php": ">=8.3",
        "hampel/validate": "~2.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1.22",
        "phpunit/phpunit": "^11.5.50|^12.0|^13.0"
    },
	"conflict": {
		"hampel/validate-laravel": "<2.0"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\Tlds\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\Tlds\\Tests\\": "tests/"
        }
	},
 	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"laravel": {
			"providers": [
				"Hampel\\Tlds\\TldServiceProvider"
			],
			"aliases": {
				"Tlds": "Hampel\\Tlds\\Facades\\Tlds"
			}
		}
	},
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
